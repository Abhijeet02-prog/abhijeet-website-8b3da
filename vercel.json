{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "trailingSlash": false,
    "redirects": [
        {
            "source": "/index.html",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/index",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/profile",
            "destination": "/profile.html",
            "permanent": true
        },
        {
            "source": "/news",
            "destination": "/news.html",
            "permanent": true
        },
        {
            "source": "/about",
            "destination": "/profile.html",
            "permanent": true
        },
        {
            "source": "/about.html",
            "destination": "/profile.html",
            "permanent": true
        },
        {
            "source": "/work",
            "destination": "/#work",
            "permanent": true
        },
        {
            "source": "/work.html",
            "destination": "/#work",
            "permanent": true
        },
        {
            "source": "/contact",
            "destination": "/#contact",
            "permanent": true
        },
        {
            "source": "/contact.html",
            "destination": "/#contact",
            "permanent": true
        },
        {
            "source": "/insights",
            "destination": "/news.html",
            "permanent": true
        },
        {
            "source": "/insights.html",
            "destination": "/news.html",
            "permanent": true
        },
        {
            "source": "/insights/:slug*",
            "destination": "/news.html",
            "permanent": true
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=604800"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                }
            ]
        }
    ],
    "functions": {
        "api/linkedin-stats.js": {
            "includeFiles": "assets/linkedin-stats.json"
        }
    },
    "crons": [
        {
            "path": "/api/instagram-refresh-token",
            "schedule": "0 6 * * *"
        },
        {
            "path": "/api/news",
            "schedule": "31 5 * * *"
        }
    ]
}
